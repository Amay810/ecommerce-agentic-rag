#!/bin/bash
#PBS -N erag_smoke_fm
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -o smoke_failure_memory.log

cd /scratch/users/ntu/s250045/ecommerce-agentic-rag

source ~/miniforge3/etc/profile.d/conda.sh
conda activate parkinson

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="$PWD"
export ERAG_SUPPORT_STORE=1
export ERAG_FRESHNESS_GUARD=1

echo "=== ensure index exists ==="
python -m ecommerce_rag.data_loader

echo ""
echo "=== run agent smoke (10 queries, diverse patterns) ==="
python nscc/smoke_failure_memory.py

echo ""
echo "=== stdlib test (failure_memory, no model needed) ==="
python tests/test_failure_memory.py
