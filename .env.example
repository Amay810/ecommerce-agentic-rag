# Local Hugging Face backend
ARAG_AGENT_BACKEND=local
ARAG_LOCAL_MODEL=Qwen/Qwen3-4B-Instruct-2507
ARAG_LOCAL_MAX_NEW_TOKENS=512

# OpenAI-compatible backend (never commit a real key)
# ARAG_AGENT_BACKEND=openai
# ARAG_LLM_BASE_URL=https://api.openai.com/v1
# ARAG_LLM_MODEL=gpt-4o-mini
# ARAG_LLM_API_KEY=replace-me

# tau3 Retail v1 (never commit real keys)
# Local vLLM/Qwen agent uses the OpenAI-compatible pair below.
# TAU3_AGENT_BASE_URL=http://127.0.0.1:8000/v1
# TAU3_AGENT_API_KEY=replace-me
# The frozen user simulator may use a separate provider/key.
# TAU3_USER_API_KEY=replace-me
# The NL-assertion judge is frozen separately and must match across Base/SFT.
# TAU3_NL_ASSERTIONS_MODEL=deepseek/deepseek-chat

# Optional retrieval configuration
ERAG_PRODUCTS=ecommerce_rag/data/sample_products.jsonl
ERAG_POLICIES=ecommerce_rag/data/policies.jsonl
ERAG_TOP_K=5
ERAG_USE_RERANKER=0
