#!/bin/bash
#PBS -N legacy-action-constraint-dev-v1
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=16:00:00
#PBS -j oe
#PBS -o logs/legacy_task_closure_action_constraint_dev_v1.pbs.log
set -euo pipefail

# Paired protocol-fixed vs constrained run. Does not overwrite protocol_fix archives.
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
module load git/2.39.2
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL=/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507
export ARAG_LOCAL_MAX_NEW_TOKENS=1024

RUN_DIR=logs/legacy_task_closure_action_constraint_dev_v1
if [ -e "$RUN_DIR" ]; then
  echo "ERROR: $RUN_DIR already exists; refusing to overwrite a formal constraint run"
  exit 1
fi

COMMIT="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain)" ]; then
  echo "ERROR: dirty worktree; formal action_constraint requires a clean tree"
  exit 1
fi

python -m scripts.run_legacy_task_closure_action_constraint \
  --output-dir "$RUN_DIR" \
  --expected-code-commit "$COMMIT" \
  --protocol-fix-commit 5fb8448c59f0f93f3477c944a2fed16cf02f0e39

echo "ACTION_CONSTRAINT_DEV_V1_COMPLETE"
echo "Locked was not run. ActionEvaluator stayed disabled."
echo "Claim boundary: runtime constraint gain, not base-model capability."
