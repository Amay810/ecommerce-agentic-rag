#!/bin/bash
#PBS -N ecommerce-evidence-smoke
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o output_evidence_smoke_v2.log
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag
export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL="${ARAG_LOCAL_MODEL:-/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507}"
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42

RUN=evidence_phase_a_smoke_v2
DB=ecommerce_rag/data/agent_env_evidence_phase_a.db
TASKS=ecommerce_rag/data/evidence_phase_a_smoke_v2.jsonl
MANIFEST=ecommerce_rag/data/evidence_phase_a_smoke_v2_manifest.json
mkdir -p logs docs
test -s ecommerce_rag/data/evidence_phase_a_tasks_v2.jsonl
test -s ecommerce_rag/index_5000/embeddings.npy
test -s "$ARAG_LOCAL_MODEL/config.json"
python -c "import json; assert json.load(open('docs/llm_contract_confirmation_v3_gate.json', encoding='utf-8'))['passed']"
python -c "from ecommerce_rag.orders import seed_database; seed_database('$DB', seed=20260728)"
python -m scripts.build_evidence_smoke \
  --tasks ecommerce_rag/data/evidence_phase_a_tasks_v2.jsonl \
  --output "$TASKS" --manifest "$MANIFEST" --per-category 3
python -m scripts.run_evidence_ablation \
  --tasks "$TASKS" --db "$DB" --index ecommerce_rag/index_5000 \
  --store-dir logs --report-dir docs --run-name "$RUN"
for variant in base evidence_verify evidence_verify_repair; do
  python -m scripts.diagnose_llm_trace \
    --store "logs/${RUN}_${variant}.sqlite" \
    --output "docs/${RUN}_${variant}_diagnosis.json" --samples-per-stage 5
done
python -m scripts.evidence_smoke_gate \
  --manifest "$MANIFEST" --store-dir logs --run-name "$RUN" \
  --output "docs/${RUN}_gate.json"
