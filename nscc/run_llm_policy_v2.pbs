#!/bin/bash
#PBS -N ecommerce-agent-v2
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o output_agent_v2.log
set -euo pipefail
cd /scratch/users/ntu/s250045/ecommerce-agentic-rag
module load miniforge3/25.3.1
module load cuda/11.8.0
source ~/miniforge3/etc/profile.d/conda.sh
conda activate ecommerce-agent
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL="${ARAG_LOCAL_MODEL:-Qwen/Qwen2.5-1.5B-Instruct}"
python -m ecommerce_rag.harness run --tasks ecommerce_rag/data/harness_tasks_v2.jsonl \
  --db ecommerce_rag/data/agent_env_v2.db --store logs/harness_v2_llm.sqlite \
  --index ecommerce_rag/index_5000 --policy llm --split locked --repeats 3 \
  --output docs/harness_v2_llm_locked_pass3.json
python -m scripts.export_trajectory_audit --store logs/harness_v2_llm.sqlite --output docs/trajectory_audit_40.csv --limit 40
python -m scripts.build_action_preferences --store logs/harness_v2_llm.sqlite --output logs/action_preferences.jsonl
python -m ecommerce_rag.rl_gate --tasks ecommerce_rag/data/harness_tasks_v2.jsonl \
  --store logs/harness_v2_llm.sqlite --audit docs/trajectory_audit_40.csv \
  --preference-pairs logs/action_preferences.jsonl --output docs/agent_rl_gate_v2.json
