#!/bin/bash
#PBS -N legacy-action-eval-v1
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o logs/legacy_task_closure_action_eval_dev_v1.pbs.log
set -euo pipefail

cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
# The runner reads the exact commit, so the pinned Git module must be loaded
# before any Git invocation inside this PBS job.
module load git/2.39.2
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL=/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507
export ARAG_LOCAL_MAX_NEW_TOKENS=1024

RUN_DIR=logs/legacy_task_closure_action_eval_dev_v1
if [ -e "$RUN_DIR" ]; then
  echo "ERROR: $RUN_DIR already exists; refusing to overwrite a formal dev run"
  exit 1
fi
: "${EXPECTED_CODE_COMMIT:?submit with qsub -v EXPECTED_CODE_COMMIT=<frozen-commit>}"
python -m scripts.run_legacy_task_closure_action_eval \
  --output-dir "$RUN_DIR" \
  --expected-code-commit "$EXPECTED_CODE_COMMIT"

echo "DEV_ACTION_EVALUATOR_COMPLETE"
echo "Locked was not run. CompletionEvaluator remains gated on report.json."
