#!/bin/bash
#PBS -N ecommerce-agent-v2
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o output_agent_v2.log
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag
export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL="${ARAG_LOCAL_MODEL:-/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507}"
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42

STORE=logs/harness_v2_llm_360.sqlite
if [ -e "$STORE" ]; then
  echo "ERROR: $STORE already exists. Archive it under a new name before submitting; this job will not mix runs."
  exit 1
fi
test -s ecommerce_rag/data/harness_tasks_v2.jsonl
test -s ecommerce_rag/data/agent_env_v2.db
test -s ecommerce_rag/index_5000/embeddings.npy
test -s "$ARAG_LOCAL_MODEL/config.json"
python -c "from transformers import AutoConfig; AutoConfig.from_pretrained('$ARAG_LOCAL_MODEL', local_files_only=True, trust_remote_code=True); print('Local agent model OK')"

mkdir -p logs docs

echo "=== LLMPolicy dev: 60 tasks x 3 ==="
python -m ecommerce_rag.harness run --tasks ecommerce_rag/data/harness_tasks_v2.jsonl \
  --db ecommerce_rag/data/agent_env_v2.db --store "$STORE" \
  --index ecommerce_rag/index_5000 --policy llm --split dev --repeats 3 \
  --output docs/harness_v2_llm_dev_pass3.json

echo "=== LLMPolicy locked: 60 tasks x 3 ==="
python -m ecommerce_rag.harness run --tasks ecommerce_rag/data/harness_tasks_v2.jsonl \
  --db ecommerce_rag/data/agent_env_v2.db --store "$STORE" \
  --index ecommerce_rag/index_5000 --policy llm --split locked --repeats 3 \
  --output docs/harness_v2_llm_locked_pass3.json

python -m scripts.export_trajectory_audit --store "$STORE" --output docs/trajectory_audit_40.csv --limit 40
python -m scripts.build_action_preferences --store "$STORE" --output logs/action_preferences.jsonl
python -m ecommerce_rag.rl_gate --tasks ecommerce_rag/data/harness_tasks_v2.jsonl \
  --store "$STORE" --audit docs/trajectory_audit_40.csv \
  --preference-pairs logs/action_preferences.jsonl --output docs/agent_rl_gate_v2.json
echo "=== 360-trajectory LLMPolicy job complete; human audit is still required ==="
