#!/bin/bash
#PBS -N memory-policy-probe-v1
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=16:00:00
#PBS -j oe
#PBS -o logs/memory_policy_probe_v1.pbs.log
set -euo pipefail

# Memory off/on causal probe. Checkout the intended commit before qsub;
# this script pins --expected-code-commit to the current clean HEAD.
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
module load git/2.39.2
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL=/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507
export ARAG_LOCAL_MAX_NEW_TOKENS=1024

RUN_DIR=logs/memory_policy_probe_v1
CASE_DB="$RUN_DIR/cases.db"
if [ -e "$RUN_DIR" ]; then
  echo "ERROR: $RUN_DIR already exists; refusing to overwrite a formal probe run"
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "ERROR: dirty worktree; formal memory_policy_probe_v1 requires a clean tree"
  exit 1
fi
COMMIT="$(git rev-parse HEAD)"

mkdir -p logs
python -m scripts.run_memory_policy_probe_v1 \
  --output-dir "$RUN_DIR" \
  --expected-code-commit "$COMMIT" \
  --case-db "$CASE_DB" \
  --seed-train

echo "MEMORY_POLICY_PROBE_V1_COMPLETE"
echo "commit=$COMMIT"
echo "Claim boundary: raw-policy Memory gain under Action Constraint; not 40/40."
