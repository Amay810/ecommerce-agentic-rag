#!/bin/bash
#PBS -N tau3-s0-serve-v1
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o logs/tau3_s0_serve_v1.pbs.log

# Qwen + S0 LoRA inference on vLLM 0.10.2. This frozen vLLM version does
# not support serving LoRA with data parallelism, so this job is single-GPU.

set -euo pipefail
cd "$PBS_O_WORKDIR"

module purge
module load cuda/12.8.1
module load miniforge3/25.3.1
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-vllm

if ! NVCC_PATH="$(command -v nvcc)"; then
  echo "cuda/12.8.1 did not provide nvcc" >&2
  exit 1
fi
export CUDA_HOME="$(dirname "$(dirname "$(readlink -f "$NVCC_PATH")")")"
export CUDA_PATH="$CUDA_HOME"
export CUDA_ROOT="$CUDA_HOME"

if [[ "${CUDA_VISIBLE_DEVICES:-}" == GPU-* ]]; then
  PBS_GPU_UUID="$CUDA_VISIBLE_DEVICES"
  GPU_INDEX="$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader | awk -F',' -v uuid="$PBS_GPU_UUID" '
    {gsub(/[[:space:]]/, "", $1); gsub(/[[:space:]]/, "", $2)}
    $2 == uuid {print $1}
  ')"
  if [[ -z "$GPU_INDEX" ]]; then
    echo "Could not map PBS GPU UUID $PBS_GPU_UUID to a numeric index" >&2
    exit 1
  fi
  export CUDA_VISIBLE_DEVICES="$GPU_INDEX"
  echo "PBS_GPU_UUID=$PBS_GPU_UUID"
fi

if [[ "$(awk -F',' '{print NF}' <<< "${CUDA_VISIBLE_DEVICES:-}")" -ne 1 ]]; then
  echo "Expected one visible GPU, got CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}" >&2
  exit 1
fi

QWEN_MODEL="${QWEN_MODEL:-/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507}"
VLLM_PORT="${TAU3_VLLM_PORT:-8123}"
TAU3_ADAPTER="${TAU3_ADAPTER:?Set TAU3_ADAPTER to the S0 checkpoint directory}"
BASE_MODEL_NAME="Qwen3-4B-Instruct-2507"
S0_MODEL_NAME="Qwen3-4B-S0"

test -s "$QWEN_MODEL/config.json"
test -s "$TAU3_ADAPTER/adapter_model.safetensors"
mkdir -p logs

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONNOUSERSITE=1
export VLLM_NO_USAGE_STATS=1
export DO_NOT_TRACK=1

export FLASHINFER_WORKSPACE_BASE="/scratch/users/ntu/s250045/.cache/flashinfer-vllm-0.10.2-cu128"
mkdir -p "$FLASHINFER_WORKSPACE_BASE"

HOSTNAME_FQDN="$(hostname -f 2>/dev/null || hostname)"
echo "TAU3_VLLM_HOST=$HOSTNAME_FQDN"
echo "TAU3_VLLM_PORT=$VLLM_PORT"
echo "TAU3_AGENT_MODEL=hosted_vllm/${S0_MODEL_NAME}"
echo "TAU3_ADAPTER=$TAU3_ADAPTER"
echo "VLLM_ENV=$CONDA_PREFIX"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
echo "CUDA_HOME=$CUDA_HOME"
echo "NVCC=$NVCC_PATH"
echo "FLASHINFER_WORKSPACE_BASE=$FLASHINFER_WORKSPACE_BASE"
nvcc --version

python - <<'PY'
import torch
import transformers
import vllm
import vllm._C

assert torch.cuda.is_available(), "PyTorch cannot see the allocated GPU"
assert torch.cuda.device_count() == 1, torch.cuda.device_count()
assert vllm.__version__ == "0.10.2", vllm.__version__
assert transformers.__version__ == "4.57.6", transformers.__version__
print(f"torch={torch.__version__}")
print(f"torch_cuda={torch.version.cuda}")
print(f"gpu={torch.cuda.get_device_name(0)}")
print(f"gpu_count={torch.cuda.device_count()}")
print(f"vllm={vllm.__version__}")
print(f"transformers={transformers.__version__}")
PY

exec vllm serve "$QWEN_MODEL" \
  --served-model-name "$BASE_MODEL_NAME" \
  --host 0.0.0.0 \
  --port "$VLLM_PORT" \
  --dtype bfloat16 \
  --max-model-len 32768 \
  --gpu-memory-utilization 0.90 \
  --data-parallel-size 1 \
  --tensor-parallel-size 1 \
  --enable-lora \
  --lora-modules "${S0_MODEL_NAME}=${TAU3_ADAPTER}" \
  --enable-auto-tool-choice \
  --tool-call-parser hermes
