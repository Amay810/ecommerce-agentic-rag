#!/bin/bash
#PBS -N erag-5k
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o output_erag_5k.log
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42
export ERAG_RERANKER_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--BAAI--bge-reranker-base/snapshots/2cfc18c9415c912f9d8155881c133215df768a70

echo "Working directory: $(pwd)"
echo "Python: $(which python)"
echo "Embed model: $ERAG_EMBED_MODEL"
echo "Reranker: $ERAG_RERANKER_MODEL"

# Dataset is uploaded/materialised on the login node before submission.
DATASET=ecommerce_rag/data/amazon_products_5k.jsonl
EXPECTED_SHA256=87e0f8a63a314d550dd6e68fa36ee8ae0cca492d037419215a5c9a702018c6a1
if [ ! -s "$DATASET" ]; then
  echo "ERROR: $DATASET is missing. Upload it before submitting this job."
  exit 1
fi
ACTUAL_LINES=$(wc -l < "$DATASET")
ACTUAL_SHA256=$(sha256sum "$DATASET" | awk '{print $1}')
if [ "$ACTUAL_LINES" -ne 5000 ] || [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
  echo "ERROR: dataset validation failed: lines=$ACTUAL_LINES sha256=$ACTUAL_SHA256"
  exit 1
fi
echo "Dataset validated: lines=$ACTUAL_LINES sha256=$ACTUAL_SHA256"
for n in 40 1000 5000; do
  python -m scripts.slice_products --input ecommerce_rag/data/amazon_products_5k.jsonl --limit "${n}" --stratify-field amazon_category_config --output "ecommerce_rag/data/amazon_products_${n}.jsonl"
  python -m ecommerce_rag.data_loader --products "ecommerce_rag/data/amazon_products_${n}.jsonl" --index-dir "ecommerce_rag/index_${n}"
done
python -m scripts.generate_retrieval_eval --products ecommerce_rag/data/amazon_products_40.jsonl --output ecommerce_rag/data/retrieval_eval_250.jsonl
for n in 40 1000 5000; do python -m ecommerce_rag.benchmark --testset ecommerce_rag/data/retrieval_eval_250.jsonl --index "ecommerce_rag/index_${n}" --output "docs/retrieval_${n}.json"; done
python -m ecommerce_rag.benchmark --testset ecommerce_rag/data/retrieval_eval_250.jsonl --index ecommerce_rag/index_5000 --constraints --output docs/retrieval_5000_constraints.json
python -m ecommerce_rag.benchmark --testset ecommerce_rag/data/retrieval_eval_250.jsonl --index ecommerce_rag/index_5000 --constraints --reranker --output docs/retrieval_5000_constraints_reranker.json

python -m scripts.generate_harness_tasks --db logs/harness_env.db --output ecommerce_rag/data/harness_tasks.jsonl --products ecommerce_rag/data/amazon_products_5k.jsonl
python -m ecommerce_rag.harness run --tasks ecommerce_rag/data/harness_tasks.jsonl --db logs/harness_env.db --store logs/trajectories.db --index ecommerce_rag/index_5000 --repeats 5 --output docs/harness_nscc.json
python -m ecommerce_rag.rl_gate --tasks ecommerce_rag/data/harness_tasks.jsonl --store logs/trajectories.db --output docs/agent_rl_gate_nscc.json
python -m ecommerce_rag.data_loader --products ecommerce_rag/data/sample_products.jsonl --policies ecommerce_rag/data/policies.jsonl --index-dir ecommerce_rag/index_regression_40
python -m ecommerce_rag.evaluate --index ecommerce_rag/index_regression_40 --output docs/original_28_regression_nscc.json
python -m unittest discover -s tests -v
