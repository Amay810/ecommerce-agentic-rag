#!/bin/bash
#PBS -N erag-index-time
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o output_erag_index_timing.log

set -euo pipefail
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42

for n in 40 1000 5000; do
  test -s "ecommerce_rag/data/amazon_products_${n}.jsonl"
  target="ecommerce_rag/index_timing_${n}"
  if [ -e "$target" ]; then
    echo "ERROR: $target already exists. Archive or remove it explicitly before rerunning."
    exit 1
  fi
  python -m ecommerce_rag.data_loader \
    --products "ecommerce_rag/data/amazon_products_${n}.jsonl" \
    --index-dir "$target" \
    --stats-output "docs/index_build_${n}_nscc.json"
done

echo "=== Index timing complete; index_timing_* directories are disposable after reviewing stats ==="
