#!/bin/bash
#PBS -N ecommerce-contract-confirm
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o output_llm_contract_confirmation_v3.log
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag
export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL="${ARAG_LOCAL_MODEL:-/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507}"
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42

STORE=logs/llm_contract_confirmation_v3.sqlite
TASKS=ecommerce_rag/data/contract_confirmation_v3.jsonl
MANIFEST=ecommerce_rag/data/contract_confirmation_v3_manifest.json
mkdir -p logs docs
if [ -e "$STORE" ]; then
  echo "ERROR: $STORE already exists; archive it before resubmitting."
  exit 1
fi
test -s ecommerce_rag/data/agent_env_v2.db
test -s ecommerce_rag/index_5000/embeddings.npy
test -s "$ARAG_LOCAL_MODEL/config.json"

python -m scripts.build_contract_confirmation \
  --tasks ecommerce_rag/data/harness_tasks_v2.jsonl \
  --output "$TASKS" --manifest "$MANIFEST"

python -m ecommerce_rag.harness run \
  --tasks "$TASKS" --db ecommerce_rag/data/agent_env_v2.db \
  --store "$STORE" --index ecommerce_rag/index_5000 \
  --policy llm --repeats 1 \
  --output docs/llm_contract_confirmation_v3_report.json

python -m scripts.diagnose_llm_trace \
  --store "$STORE" --output docs/llm_contract_confirmation_v3_diagnosis.json \
  --samples-per-stage 5

python -m scripts.smoke_gate \
  --manifest "$MANIFEST" \
  --report docs/llm_contract_confirmation_v3_report.json \
  --diagnosis docs/llm_contract_confirmation_v3_diagnosis.json \
  --min-parse-rate 0.9 \
  --output docs/llm_contract_confirmation_v3_gate.json
