#!/bin/bash
#PBS -N erag-audit-evidence
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o output_erag_audit_evidence.log

set -euo pipefail
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42

test -s ecommerce_rag/data/amazon_products_5k.jsonl
test -s ecommerce_rag/data/retrieval_eval_v2_300.jsonl
test -s ecommerce_rag/index_5000/embeddings.npy
test -s docs/retrieval_human_audit_50.csv

python -m scripts.build_retrieval_audit_evidence \
  --audit docs/retrieval_human_audit_50.csv \
  --benchmark ecommerce_rag/data/retrieval_eval_v2_300.jsonl \
  --products ecommerce_rag/data/amazon_products_5k.jsonl \
  --index ecommerce_rag/index_5000 \
  --json-output docs/retrieval_audit_evidence_50.json \
  --html-output docs/retrieval_audit_panel_50.html

echo "=== Retrieval audit evidence package complete ==="
