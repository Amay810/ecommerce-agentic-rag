#!/bin/bash
#PBS -N tau3-teacher-serve-v1
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=32:ngpus=4:mem=220gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o logs/tau3_teacher_serve_v1.pbs.log

# Open-weight teacher inference only. Windows orchestrates DeepSeek user/judge
# and τ³ Retail evaluation through an SSH tunnel to this vLLM endpoint.

set -euo pipefail
cd "${PBS_O_WORKDIR:-/scratch/users/ntu/s250045/ecommerce-agentic-rag-m1}"

module purge
module load cuda/12.8.1
module load miniforge3/25.3.1
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-vllm

if ! NVCC_PATH="$(command -v nvcc)"; then
  echo "cuda/12.8.1 did not provide nvcc" >&2
  exit 1
fi
export CUDA_HOME="$(dirname "$(dirname "$(readlink -f "$NVCC_PATH")")")"
export CUDA_PATH="$CUDA_HOME"
export CUDA_ROOT="$CUDA_HOME"

if [[ "${CUDA_VISIBLE_DEVICES:-}" == GPU-* ]]; then
  PBS_GPU_UUIDS="$CUDA_VISIBLE_DEVICES"
  IFS=',' read -r -a GPU_UUID_ARRAY <<< "$PBS_GPU_UUIDS"
  GPU_INDEX_ARRAY=()
  while IFS=',' read -r gpu_index gpu_uuid; do
    gpu_index="${gpu_index//[[:space:]]/}"
    gpu_uuid="${gpu_uuid//[[:space:]]/}"
    for allocated_uuid in "${GPU_UUID_ARRAY[@]}"; do
      allocated_uuid="${allocated_uuid//[[:space:]]/}"
      if [[ "$gpu_uuid" == "$allocated_uuid" ]]; then
        GPU_INDEX_ARRAY+=("$gpu_index")
      fi
    done
  done < <(nvidia-smi --query-gpu=index,uuid --format=csv,noheader)
  if [[ "${#GPU_INDEX_ARRAY[@]}" -ne 4 ]]; then
    echo "Expected four PBS GPU UUIDs, mapped ${#GPU_INDEX_ARRAY[@]}: $PBS_GPU_UUIDS" >&2
    exit 1
  fi
  export CUDA_VISIBLE_DEVICES="$(IFS=,; echo "${GPU_INDEX_ARRAY[*]}")"
  echo "PBS_GPU_UUIDS=$PBS_GPU_UUIDS"
fi

TEACHER_MODEL="${TEACHER_MODEL:-/scratch/users/ntu/s250045/models/Qwen3-30B-A3B-Instruct-2507}"
TEACHER_MODEL_ID="${TEACHER_MODEL_ID:-Qwen3-30B-A3B-Instruct-2507}"
TEACHER_TP="${TEACHER_TP:-4}"
VLLM_PORT="${TAU3_VLLM_PORT:-8124}"
MAX_MODEL_LEN="${TEACHER_MAX_MODEL_LEN:-32768}"

test -s "$TEACHER_MODEL/config.json"
test -s "$TEACHER_MODEL/model.safetensors.index.json" || test -n "$(ls "$TEACHER_MODEL"/model-*.safetensors 2>/dev/null | head -1)"
mkdir -p logs data/verified_ecommerce_sft_v1

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONNOUSERSITE=1
export VLLM_NO_USAGE_STATS=1
export DO_NOT_TRACK=1
export FLASHINFER_WORKSPACE_BASE="/scratch/users/ntu/s250045/.cache/flashinfer-vllm-0.10.2-cu128"
mkdir -p "$FLASHINFER_WORKSPACE_BASE"

HOSTNAME_FQDN="$(hostname -f 2>/dev/null || hostname)"
{
  echo "teacher_model=$TEACHER_MODEL"
  echo "teacher_model_id=$TEACHER_MODEL_ID"
  echo "teacher_license=apache-2.0"
  echo "teacher_source=https://huggingface.co/Qwen/Qwen3-30B-A3B-Instruct-2507"
  echo "vllm_version=0.10.2"
  echo "tool_parser=hermes"
  echo "dtype=bfloat16"
  echo "tensor_parallel=$TEACHER_TP"
  echo "max_model_len=$MAX_MODEL_LEN"
  echo "TAU3_VLLM_HOST=$HOSTNAME_FQDN"
  echo "TAU3_VLLM_PORT=$VLLM_PORT"
  echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
} | tee logs/tau3_teacher_serve_v1.meta.txt

python - <<'PY'
import torch
import transformers
import vllm

assert torch.cuda.is_available(), "PyTorch cannot see the allocated GPU"
assert torch.cuda.device_count() == 4, torch.cuda.device_count()
assert vllm.__version__ == "0.10.2", vllm.__version__
print("transformers", transformers.__version__)
print("torch", torch.__version__)
PY

python -m vllm.entrypoints.openai.api_server \
  --model "$TEACHER_MODEL" \
  --served-model-name "$TEACHER_MODEL_ID" \
  --host 0.0.0.0 \
  --port "$VLLM_PORT" \
  --dtype bfloat16 \
  --max-model-len "$MAX_MODEL_LEN" \
  --gpu-memory-utilization 0.90 \
  --tensor-parallel-size "$TEACHER_TP" \
  --enable-auto-tool-choice \
  --tool-call-parser hermes
