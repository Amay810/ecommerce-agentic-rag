#!/bin/bash
#PBS -N ecommerce-llm-smoke
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o output_llm_smoke.log
#
# Eight covering tasks, not 360. The previous full run produced 360 trajectories
# that were all the same parse failure and could not be attributed to anything,
# so this job exists to answer "does the loop work at all" cheaply, and to refuse
# to hand off to the full evaluation unless it does.
#
# Order matters: the backend is probed before any task runs, because model and
# tokenizer loading happen while the generator is constructed — before the
# policy exists and before its per-generation guard can record anything.
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag
export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL="${ARAG_LOCAL_MODEL:-/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507}"
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42

MIN_PARSE_RATE="${MIN_PARSE_RATE:-0.9}"
STORE=logs/llm_smoke.sqlite
mkdir -p logs docs

if [ -e "$STORE" ]; then
  echo "ERROR: $STORE already exists. Archive it before resubmitting; this job will not mix runs."
  exit 1
fi

test -s ecommerce_rag/data/agent_env_v2.db
test -s ecommerce_rag/index_5000/embeddings.npy
test -s "$ARAG_LOCAL_MODEL/config.json"

echo "=== 0. build the covering smoke set (8 scenarios, dev split only) ==="
python -m scripts.build_smoke_tasks \
  --tasks ecommerce_rag/data/harness_tasks_v2.jsonl \
  --output ecommerce_rag/data/harness_smoke.jsonl \
  --manifest ecommerce_rag/data/harness_smoke_manifest.json \
  --split dev

echo "=== 1. probe the backend before spending anything on tasks ==="
# Load failures, a bad model path, an OOM at load time or a chat-template probe
# raising something other than TypeError all happen here, outside any trajectory.
python - <<'PY'
import json, sys
from pathlib import Path
from ecommerce_rag.llm_policy import LLMPolicy

probe = LLMPolicy.probe_backend()
Path("docs").mkdir(exist_ok=True)
Path("docs/llm_backend_probe.json").write_text(
    json.dumps(probe, ensure_ascii=False, indent=2), encoding="utf-8")
print(json.dumps(probe, ensure_ascii=False, indent=2))
if not probe.get("ok"):
    print(f"\nBackend probe failed at stage {probe.get('stage')}: "
          f"{probe.get('error_type')}: {probe.get('error')}")
    sys.exit(1)
PY

echo "=== 2. run the smoke set (1 repeat: nothing here is stochastic) ==="
python -m ecommerce_rag.harness run \
  --tasks ecommerce_rag/data/harness_smoke.jsonl \
  --db ecommerce_rag/data/agent_env_v2.db \
  --store "$STORE" \
  --index ecommerce_rag/index_5000 \
  --policy llm --repeats 1 \
  --output docs/llm_smoke_report.json

echo "=== 3. attribute every generation ==="
python -m scripts.diagnose_llm_trace \
  --store "$STORE" \
  --output docs/llm_smoke_diagnosis.json \
  --samples-per-stage 5

echo "=== 4. gate: is the full evaluation justified? ==="
# Deliberately strict. A non-zero parse rate is not evidence the loop works;
# one success in ten would clear that bar and waste the next run.
set +e
python -m scripts.smoke_gate \
  --manifest ecommerce_rag/data/harness_smoke_manifest.json \
  --report docs/llm_smoke_report.json \
  --diagnosis docs/llm_smoke_diagnosis.json \
  --min-parse-rate "$MIN_PARSE_RATE" \
  --output docs/llm_smoke_gate.json
GATE=$?
set -e

echo
if [ "$GATE" -ne 0 ]; then
  echo "SMOKE GATE FAILED — do not submit the full evaluation."
  echo "Read docs/llm_smoke_diagnosis.json: parse_stages says where it broke and"
  echo "failure_samples carries the model's raw output for each stage."
  exit "$GATE"
fi

echo "SMOKE GATE PASSED — the full evaluation is justified."
echo "Artifacts: docs/llm_backend_probe.json, docs/llm_smoke_report.json,"
echo "           docs/llm_smoke_diagnosis.json, docs/llm_smoke_gate.json"
