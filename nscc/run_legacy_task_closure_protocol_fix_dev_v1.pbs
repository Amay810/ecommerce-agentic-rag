#!/bin/bash
#PBS -N legacy-protocol-fix-dev-v1
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o logs/legacy_task_closure_protocol_fix_dev_v1.pbs.log
set -euo pipefail

# Submit with qsub from a clean worktree that contains the protocol-fix commit.
# This run must not overwrite logs/legacy_task_closure_action_eval_dev_v1/.
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
module load git/2.39.2
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL=/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507
export ARAG_LOCAL_MAX_NEW_TOKENS=1024

RUN_DIR=logs/legacy_task_closure_protocol_fix_dev_v1
if [ -e "$RUN_DIR" ]; then
  echo "ERROR: $RUN_DIR already exists; refusing to overwrite a formal protocol_fix run"
  exit 1
fi
if [ -e logs/legacy_task_closure_action_eval_dev_v1/report.json ]; then
  echo "INFO: archived legacy_progress_fixed artifacts present; leaving them untouched"
fi

COMMIT="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain)" ]; then
  echo "ERROR: dirty worktree; formal protocol_fix requires a clean tree"
  exit 1
fi

python -m scripts.run_legacy_task_closure_protocol_fix \
  --output-dir "$RUN_DIR" \
  --expected-code-commit "$COMMIT" \
  --formal-baseline-commit ff6af987ff034ec3140679070038ae928ec65ca0

echo "PROTOCOL_FIX_DEV_V1_COMPLETE"
echo "Locked was not run. ActionEvaluator and SemanticFactExtractor stayed disabled."
echo "Claim boundary: formal Qwen evidence is this run only; RulePolicy tests are separate."
