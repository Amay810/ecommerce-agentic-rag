#!/bin/bash
#PBS -N legacy-progress-dev-v2
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o logs/legacy_task_closure_progress_dev_v2.pbs.log
set -euo pipefail

# Submit with qsub from the checked-out feat/legacy-task-closure worktree.
cd "$PBS_O_WORKDIR"
module load miniforge3/25.3.1
module load cuda/11.8.0
# The runner records the exact commit. Git in PBS is permitted only after the
# pinned module is loaded.
module load git/2.39.2
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ARAG_AGENT_BACKEND=local
export ARAG_LOCAL_MODEL=/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507
export ARAG_LOCAL_MAX_NEW_TOKENS=1024

RUN_DIR=logs/legacy_task_closure_progress_dev_v2
if [ -e "$RUN_DIR" ]; then
  echo "ERROR: $RUN_DIR already exists; refusing to overwrite a formal dev run"
  exit 1
fi
COMMIT="$(git rev-parse HEAD)"
python -m scripts.run_legacy_task_closure_progress \
  --output-dir "$RUN_DIR" \
  --expected-code-commit "$COMMIT"

echo "DEV_PROGRESS_V2_COMPLETE"
echo "Locked was not run. ActionEvaluator remains gated on report.json."
