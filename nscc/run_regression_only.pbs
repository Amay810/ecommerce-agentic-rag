#!/bin/bash
#PBS -N erag-regression
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o output_erag_regression.log

set -euo pipefail
cd "$PBS_O_WORKDIR"

module load miniforge3/25.3.1
module load cuda/11.8.0
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-rag

export HF_HOME=/scratch/users/ntu/s250045/cache/huggingface-ecommerce
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export ERAG_EMBED_MODEL=/scratch/users/ntu/s250045/cache/huggingface-ecommerce/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42

mkdir -p docs

python -m ecommerce_rag.data_loader \
  --products ecommerce_rag/data/sample_products.jsonl \
  --policies ecommerce_rag/data/policies.jsonl \
  --index-dir ecommerce_rag/index_regression_40 \
  --stats-output docs/index_build_regression_40.json

python -m ecommerce_rag.evaluate \
  --index ecommerce_rag/index_regression_40 \
  --output docs/original_28_regression_after_fix_nscc.json

python -m unittest discover -s tests -v
echo "=== Regression job complete ==="
