#!/bin/bash
#PBS -N ecommerce-m1-serve-v1
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o logs/ecommerce_m1_serve_v1.pbs.log

set -euo pipefail
cd "$PBS_O_WORKDIR"

module purge
module load cuda/12.8.1
module load miniforge3/25.3.1
source activate /scratch/users/ntu/s250045/conda-envs/ecommerce-vllm

QWEN_MODEL="${QWEN_MODEL:-/scratch/users/ntu/s250045/models/Qwen3-4B-Instruct-2507}"
M1_ADAPTER="${M1_ADAPTER:?Set M1_ADAPTER to the trained checkpoint directory}"
VLLM_PORT="${TAU3_VLLM_PORT:-8123}"
BASE_NAME="Qwen3-4B-Instruct-2507"
M1_NAME="Qwen3-4B-Ecommerce-M1"

test -s "$QWEN_MODEL/config.json"
test -s "$M1_ADAPTER/adapter_model.safetensors"
mkdir -p logs
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export VLLM_NO_USAGE_STATS=1 DO_NOT_TRACK=1

echo "TAU3_VLLM_HOST=$(hostname -f 2>/dev/null || hostname)"
echo "TAU3_VLLM_PORT=$VLLM_PORT"
echo "TAU3_AGENT_MODEL=hosted_vllm/${M1_NAME}"
echo "M1_ADAPTER=$M1_ADAPTER"

exec vllm serve "$QWEN_MODEL" \
  --served-model-name "$BASE_NAME" \
  --host 0.0.0.0 \
  --port "$VLLM_PORT" \
  --dtype bfloat16 \
  --max-model-len 32768 \
  --gpu-memory-utilization 0.90 \
  --data-parallel-size 1 \
  --tensor-parallel-size 1 \
  --enable-lora \
  --lora-modules "${M1_NAME}=${M1_ADAPTER}" \
  --enable-auto-tool-choice \
  --tool-call-parser hermes
