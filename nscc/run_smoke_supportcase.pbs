#!/bin/bash
#PBS -N erag_smoke_sc
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -o smoke_supportcase.log

set -euo pipefail

cd /scratch/users/ntu/s250045/ecommerce-agentic-rag

source ~/miniforge3/etc/profile.d/conda.sh
conda activate parkinson

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="$PWD"   # so `python nscc/smoke_supportcase.py` can import ecommerce_rag

echo "=== ensure index exists ==="
python -m ecommerce_rag.data_loader

echo ""
echo "=== run agent smoke (enable_logging=True) ==="
python nscc/smoke_supportcase.py

echo ""
echo "=== store CLI: count / recent / needs-review ==="
python -m ecommerce_rag.store --count
python -m ecommerce_rag.store --recent 5
python -m ecommerce_rag.store --needs-review
